# Run npm run setup:env to generate .env.local with random credentials.
DATABASE_URL=postgresql://games:CHANGE_ME@localhost:5432/games
DB_PASSWORD=CHANGE_ME
PUBLIC_ORIGIN=http://localhost:3000
SETUP_TOKEN=GENERATE_WITH_NPM_RUN_SETUP_ENV
STEAM_AUTH_ENABLED=true
# Enable only behind a proxy that overwrites X-Forwarded-For and blocks direct access.
TRUST_PROXY=false
# Optional legal pages for your own installation.
IMPRINT_URL=
PRIVACY_URL=

# Hinter einem Reverse Proxy erforderlich; nur bei gesperrtem Direktzugriff aktivieren.
TRUSTED_PROXY_HOPS=1
