{
  "name": "gamequeue",
  "version": "1.3.0",
  "private": true,
  "scripts": {
    "dev": "npm run migrate && next dev",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "node --env-file-if-exists=.env.local --import ./scripts/register-paths.mjs scripts/start.mjs",
    "seed": "node --env-file-if-exists=.env.local --import ./scripts/register-paths.mjs scripts/seed.mjs",
    "quality": "npm run lint && npm run typecheck && npm test && npm run build",
    "typecheck": "tsc --noEmit",
    "setup:env": "node scripts/setup-env.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --import ./scripts/register-paths.mjs --test tests/integration.mjs",
    "reset-admin": "node --env-file-if-exists=.env.local scripts/reset-admin.mjs",
    "refresh-steam": "node --env-file-if-exists=.env.local --import ./scripts/register-paths.mjs scripts/refresh-steam.mjs",
    "migrate": "node --env-file-if-exists=.env.local --import ./scripts/register-paths.mjs scripts/migrate.mjs",
    "test:upgrade": "node --import ./scripts/register-paths.mjs --test tests/upgrade.mjs",
    "lint": "eslint . --max-warnings=0"
  },
  "dependencies": {
    "lucide-react": "^1.77.0",
    "next": "16.4.5",
    "pg": "^8.13.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.5"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "undici": "7.30.2"
  },
  "description": "Self-hosted community game queue with Steam imports, voting and standalone authentication",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  }
}
